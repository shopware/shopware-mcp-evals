.env
.claude/
# Editor / type-checker setup, kept personal like .claude/ above. Unlike
# .editorconfig and ruff.toml, which are shared because CI enforces them.
.zed/
pyrightconfig.json
.basedpyright/
results/*.json
# Per-run job-summary rows (eval/runner.py --summary-row); `results/*.json` above
# only covers the top level.
results/rows/
__pycache__/
*.pyc
.venv/
.ruff_cache/
.pytest_cache/
# Build/coverage artifacts from `pip install -e .` and `pytest --cov`.
*.egg-info/
.coverage
.coverage.*

# tool-history is tracked deliberately (audit trail of MCP descriptions)
!tool-history/
