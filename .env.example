# Shopware MCP server endpoint
SW_BASE_URL=http://localhost:8000

# Integration access key (Admin API > Integrations in Shopware admin)
SW_ACCESS_KEY=your-access-key-here
SW_SECRET_ACCESS_KEY=your-secret-access-key-here

# Required for Layer 2 (LLM eval) — set whichever provider you use
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional: set default provider (anthropic or openai)
EVAL_PROVIDER=anthropic

# Optional: override default model (anthropic default: claude-sonnet-4-6, openai default: gpt-4o)
EVAL_MODEL=
